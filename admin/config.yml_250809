backend:
  name: git-gateway
  repo: kikyung/kikyung.github.io
  branch: main
  publish_mode: editorial_workflow

media_folder: "assets/img/uploads"
public_folder: "/assets/img/uploads"

collections:
  - name: "posts"
    label: "Posts"
    folder: "_posts"
    create: true
    slug: "{{year}}-{{month}}-{{day}}-{{fields.slug}}"
    fields:
        - { label: "Title", name: "title", widget: "string" }
        - { label: "Slug (영문)", name: "slug", widget: "string", hint: "URL용 영문 이름 (예: domain-driven-design)" }
        - { label: "Permalink (선택)", name: "permalink", widget: "string", required: false }
        - { label: "Date", name: "date", widget: "datetime" }
        - { label: "Categories", name: "categories", widget: "list", default: ["Blog"] }
        - { label: "Tags", name: "tags", widget: "list" }
        - { label: "Body", name: "body", widget: "markdown" }
